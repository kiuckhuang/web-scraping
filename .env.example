# =============================================================================
#  Environment variables — copy to .env and edit
# =============================================================================
#  Keep the values below as defaults unless you have a specific reason to change
#  them. The defaults are chosen to work out of the box.
# =============================================================================

# ---------------------------------------------------------------------------
#  Secrets — generate fresh for every deployment
# ---------------------------------------------------------------------------
# SearXNG secret key (auto-generated by make init)
SEARXNG_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# MCP bearer token — required for remote (non-localhost) connections.
# Localhost bypasses auth. Auto-generated by make init.
# WARNING: if left empty, authentication is DISABLED entirely.
MCP_API_KEY=change-me-init-will-generate
# Host address for the MCP port. Keep loopback unless remote access is needed.
MCP_BIND_HOST=127.0.0.1

# MCP security knobs (seconds / requests / bytes)
# Idle session lifetime before the server expires it (default 30 min)
# MCP_SESSION_TTL=1800
# Max requests per minute per client IP (0 = unlimited)
# MCP_RATE_LIMIT=120
# Max request body size in bytes
# MCP_MAX_BODY=1048576
# Trusted client CIDRs that bypass bearer auth (comma-separated). Empty =
# auto-detect loopback + this container's /24 subnets (podman-forwarded hosts).
# Set e.g. "127.0.0.0/8,::1/128" to require a token from everything else.
# MCP_TRUSTED_CIDRS=
# CORS policy for browser-based MCP clients. Compared against the browser's
# Origin header, which is scheme + host + port (e.g. http://localhost:8184) —
# a bare hostname never matches. "localhost" allows localhost/127.0.0.1/::1
# on any port; otherwise list exact origins, comma-separated, or "*" to allow
# any origin. Empty disables CORS. "*" is refused unless MCP_API_KEY is set
# (loopback/podman clients bypass auth, so wildcard CORS without a key would
# let any website in a browser call the unauthenticated endpoint). Note: even
# with a valid MCP_API_KEY the browser sends a CORS preflight (OPTIONS) that
# never carries the key, so the origin must match here regardless — CORS
# cannot be skipped for key-authenticated requests.
# MCP_ALLOWED_ORIGIN=http://host-a:8184,https://host-b.example.com
MCP_ALLOWED_ORIGIN=localhost
# Result token budgets — chars per item returned to AI agents
# MCP_SNIPPET_CHARS=300
# MCP_CONTENT_CHARS=5000
# MCP_COMBINED_CHARS=1200


# ---------------------------------------------------------------------------
#  Ports — change only if these conflict with existing services
# ---------------------------------------------------------------------------
PORT_SEARXNG=8888
PORT_CAMOUFOX=9223
PORT_BRIDGE=8000
PORT_MCP=9100


# ---------------------------------------------------------------------------
#  Egress proxy (stack-wide) — one knob for ALL outbound traffic
# ---------------------------------------------------------------------------
# Set this when your direct egress IP is bot-challenged (google/duckduckgo
# served CAPTCHAs without it; e.g. the campus proxy http://10.8.8.1:8088).
# It routes SearXNG engine requests, the Camoufox browser, and the HTTP fast
# path through the same exit (GeoIP-consistent fingerprints auto-enable on
# the browser). The per-component knobs below (SEARXNG_OUTGOING_PROXY,
# CAMOUFOX_PROXY_*, HTTP_FASTPATH_PROXY) override it per transport when you
# need different exits; leave them unset to inherit this one.
# EGRESS_PROXY=http://10.8.8.1:8088


# ---------------------------------------------------------------------------
#  SearXNG engine tuning — defaults are sensible for most workloads
# ---------------------------------------------------------------------------
# - SUSPEND_TOO_MANY: seconds an engine is suspended after a 429 (rate limit).
#   Increase to be gentler on upstreams; lower to fail over faster.
# - CHANNEL: image tag to run. The compose default is pinned to this release.
SEARXNG_CHANNEL=2026.8.28-a30b2d474
SEARXNG_REQUEST_TIMEOUT=10
SEARXNG_MAX_REQUEST_TIMEOUT=15
SEARXNG_BAN_TIME_ON_FAIL=5
SEARXNG_MAX_BAN_TIME_ON_FAIL=120
SEARXNG_SUSPEND_TOO_MANY=180
# Outbound proxy for engine requests — overrides EGRESS_PROXY for SearXNG
# only (empty = inherit EGRESS_PROXY, or direct if that is unset too).
SEARXNG_OUTGOING_PROXY=
SEARXNG_FORCE_OWNERSHIP=true
SEARXNG_UWSGI_THREADS=4


# ---------------------------------------------------------------------------
#  Container-internal URLs — only change if you renamed services in compose
# ---------------------------------------------------------------------------
SEARXNG_URL=http://searxng:8080
CAMOUFOX_WS_URL=ws://camoufox:9222/browser
BRIDGE_URL=http://bridge:8000


# ---------------------------------------------------------------------------
#  Bridge service
# ---------------------------------------------------------------------------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
# Scrape cache: repeat scrapes of the same URL within the TTL are served from
# memory (no browser round-trip). Seconds + max cached pages.
BRIDGE_CACHE_TTL=300
BRIDGE_CACHE_MAX=100
BRIDGE_CACHE_MAX_BYTES=26214400
# HTTP fast path: static pages are fetched directly with a Chrome-shaped TLS
# stack (curl_cffi) instead of the stealth browser — much faster, and the
# shaped JA3 fingerprint passes TLS-fingerprint gates. WAF challenges,
# JS-rendered shells and HTTP errors escalate to Camoufox automatically.
# Named sessions (login persistence) always use the browser: the fast path is
# cookieless.
HTTP_FASTPATH=true
# HTTP_FASTPATH_TIMEOUT=15
# HTTP_FASTPATH_IMPERSONATE=chrome
# Optional egress proxy for the HTTP path only — overrides EGRESS_PROXY for
# the fast path (empty = inherit EGRESS_PROXY, or direct if that is unset).
# HTTP_FASTPATH_PROXY=http://10.8.8.1:8088
# Search chain — SearXNG's httpx-based engine scraping is routinely
# bot-challenged into zero results while the stealth browser gets through,
# so "browser" (Camoufox SERPs first, SearXNG as fallback) is the default.
# Set "searxng" for lower latency on IPs that engines don't challenge.
SEARCH_PRIMARY=browser
# Browser SERP engine order (tried left to right, first non-empty wins;
# engines tripping the empty-results circuit breaker are skipped for 10 min).
BROWSER_SEARCH_ENGINES=google,duckduckgo,duckduckgo lite
# Optional extra stage between the two transports: a forced "!bing" SearXNG
# query. Default off — bing result quality proved useless in practice.
SEARCH_FALLBACK_BING=false
# Allow the browser-SERP stage at all (as primary or fallback).
SEARCH_FALLBACK_BROWSER=true
# Wall-clock budget for a single /crawl call in seconds (0 = unlimited).
CRAWL_MAX_SECONDS=1800
# TTL in seconds for cached SSRF DNS verdicts (0 disables caching). The
# browser-side guard resolves DNS per subresource; the cache keeps JS-heavy
# pages from hammering the resolver.
SSRF_DNS_CACHE_TTL=60
# Log level for the bridge and MCP services (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
#  Camoufox engine tuning — defaults are sensible for most workloads
# ---------------------------------------------------------------------------
# Shared memory size (increase for heavy scraping workloads)
# Resource limits for the ws-camoufox container (ceilings, not reservations).
# Defaults sized for modern systems with ample RAM; scale down on small hosts.
CAMOUFOX_MEM_LIMIT=4g
CAMOUFOX_PIDS_LIMIT=1024
CAMOUFOX_SHM_SIZE=4gb
# Post-navigation pause in ms before content extraction (crawl, SERP, and
# extract-mode pages; fetch mode skips it to stay fast as the fallback path)
CAMOUFOX_NAV_DELAY=400
CAMOUFOX_TIMEOUT=60
CAMOUFOX_NAV_WAIT=domcontentloaded
CAMOUFOX_MAX_CONCURRENT_PAGES=3
CAMOUFOX_WAF_WAIT=15
CAMOUFOX_ISOLATE_CONTEXTS=true
# Max concurrent named sessions (login persistence; see README "Named sessions")
CAMOUFOX_MAX_SESSIONS=16
# Outbound proxy for ALL browser traffic (http/https/socks5) — overrides
# EGRESS_PROXY for the browser only (unset = inherit EGRESS_PROXY, or direct
# if that is unset too). Credentials live here — never commit .env.
# CAMOUFOX_PROXY_SERVER=socks5://proxy-host:1080
# CAMOUFOX_PROXY_USERNAME=
# CAMOUFOX_PROXY_PASSWORD=
# Comma-separated hosts that bypass the proxy (optional)
# CAMOUFOX_PROXY_BYPASS=localhost,127.0.0.1
# GeoIP-consistent fingerprints: timezone/locale/lat-lon matched to the proxy's
# egress IP. "auto" (default) enables it whenever a proxy is set; "true"/"false"
# force it either way. The GeoIP database is bundled in the image.
# CAMOUFOX_GEOIP=auto
# Timezone for browser contexts. Unset = auto-derived from the proxy's egress
# IP (ip-api.com through the proxy, once); set explicitly to override.
# CAMOUFOX_TIMEZONE=Asia/Hong_Kong


# ---------------------------------------------------------------------------
#  Host user UID/GID — replaced automatically by `make init`
#  Do not edit manually; re-run `make init` if you switch users.
# ---------------------------------------------------------------------------
APP_UID=1000
APP_GID=1000
