# Local configuration — make init generates secrets and refreshes image pins.
# Existing API keys, enable/disable flags and overrides are always preserved.
# Advanced tuning: copy individual entries from .env.advanced.example.

# Authentication (generated once; do not share .env).
MCP_API_KEY=change-me-init-will-generate
SEARXNG_SECRET_KEY=change-me-to-a-random-64-char-hex-string
MCP_BIND_HOST=127.0.0.1

# Optional search/content providers.
SEARXNG_ENABLED=false
JINA_ENABLED=false
JINA_API_KEY=
EXA_ENABLED=false
EXA_API_KEY=
CERAMIC_ENABLED=false
CERAMIC_API_KEY=

# Search priority when SearXNG is enabled; otherwise browser first.
SEARCH_PRIMARY=browser

# Stack-wide outbound proxy; empty means direct upstream egress.
EGRESS_PROXY=

# Managed image pin — make init updates this even in existing .env files.
SEARXNG_CHANNEL=2026.9.30-a9d990033

# Host IDs — generated on first setup and preserved thereafter.
APP_UID=1000
APP_GID=1000
