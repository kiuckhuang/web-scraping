# =============================================================================
#  Environment variables — copy to .env and edit
# =============================================================================

# SearXNG secret key — generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Optional: residential proxy for Fortress egress (helps with hard targets)
# TILION_PROXY=http://user:pass@proxy-host:port
# TILION_REGION=us

# Optional: CAPTCHA solver for bot-protected sites
# CAPTCHA_API_KEY=your-2captcha-or-capsolver-key
# CAPTCHA_PROVIDER=2captcha

# Bridge service
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000

# SearXNG and Fortress URLs (container-internal; don't change unless
# you renamed the services in podman-compose.yml)
SEARXNG_URL=http://searxng:8080
FORTRESS_CDP_URL=http://fortress:9222
