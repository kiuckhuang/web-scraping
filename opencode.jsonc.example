{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "web-scrape": {
      "type": "local",
      "command": ["python", "-m", "bridge.mcp_server"],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://localhost:8888",
        "FORTRESS_CDP_URL": "http://localhost:9222"
      }
    }
  }
}
