{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "web-scrape": {
      "type": "remote",
      "url": "http://localhost:9100/mcp",
      "enabled": true
    }
  }
}

// For a REMOTE connection (different machine), add the Authorization header:
//
// {
//   "mcp": {
//     "web-scrape": {
//       "type": "remote",
//       "url": "http://YOUR_HOST:9100/mcp",
//       "headers": {
//         "Authorization": "Bearer YOUR_MCP_API_KEY"
//       }
//     }
//   }
// }
