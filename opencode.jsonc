{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tilion": {
      "type": "local",
      "command": ["tilion-mcp", "--user-data-dir=~/.chromium"],
      "enabled": true,
      "environment": {
        "TILION_MCP_HEADLESS": "0",
        "FORTRESS_CHANNEL": "latest"
      }
    }
  }
}
